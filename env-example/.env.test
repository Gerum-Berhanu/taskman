# App
DEBUG=true

# Auth
SECRET_KEY=secret-key-change-me
SESSION_PURGE_INTERVAL_SECONDS=3600

# Email
EMAIL_ENABLED=false
EMAIL_FROM=email_from
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
SMTP_HOST=smtp_host
SMTP_PASSWORD=smtp_password
SMTP_PORT=smtp_port
SMTP_USER=smtp_user

# Features
ALLOWED_EMAIL_DOMAINS=[]
REGISTRATION_OTP_LENGTH=6
REGISTRATION_OTP_MAX_ATTEMPTS=5
REGISTRATION_OTP_TTL_SECONDS=600
TASK_BULK_MAX_ITEMS=50
TASK_SUMMARY_CACHE_TTL_SECONDS=300

# Infra
DATABASE_URL=sqlite+aiosqlite:///./test.db
RABBITMQ_PASSWORD=PASSWORD
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:PORT//
RABBITMQ_USER=USER
RATE_LIMIT_ENABLED=false
REDIS_CACHE_URL=redis://HOST:PORT/0
REDIS_RATE_LIMIT_URL=redis://HOST:PORT/1
REDIS_REGISTRATION_URL=redis://HOST:PORT/2

# Observability
LOG_FILE=false
LOG_JSON=false
LOG_LEVEL=DEBUG

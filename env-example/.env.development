DEBUG=true
SECRET_KEY=secret-key-change-me

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
REDIS_URL=redis://HOST:PORT/DB_IDX
TASK_SUMMARY_CACHE_TTL_SECONDS=300

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=auth-limit
RATE_LIMIT_AUTH_WINDOW_SECONDS=auth-window-seconds
RATE_LIMIT_REQUESTS=limit
RATE_LIMIT_WINDOW_SECONDS=window-seconds

LOG_LEVEL=DEBUG
LOG_JSON=false
LOG_FILE=true

EMAIL_ENABLED=true
# Prefer Resend on hosts that block SMTP (e.g. Render free). Empty → SMTP.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.devresend_api_key
SMTP_HOST=smtp_host
SMTP_PORT=smtp_port
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password
EMAIL_FROM=email_from

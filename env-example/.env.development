DEBUG=true
SECRET_KEY=secret-key-change-me

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
REDIS_URL=redis://HOST:PORT/DB_IDX
TASK_SUMMARY_CACHE_TTL_SECONDS=300

RATE_LIMIT_ENABLED=true

LOG_LEVEL=DEBUG
LOG_JSON=false
LOG_FILE=true

EMAIL_ENABLED=true
# Prefer Resend on hosts that block SMTP (e.g. Render free). Empty → SMTP.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Local Mailpit (run `mailpit` → UI http://localhost:8025). Empty user/password → plain SMTP.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=taskman@localhost

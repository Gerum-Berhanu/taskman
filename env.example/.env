# Shared defaults for every environment (no secrets).
# Runtime copies live in gitignored `env/` (same filenames).
# Profile overlays: development | staging | test | production
# Select profile at run time via TASKMAN_ENV (default: development).
# Do not put TASKMAN_ENV here — set it in the process (Just / shell / Compose).

APP_NAME=Taskman
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_MINUTES=10080
